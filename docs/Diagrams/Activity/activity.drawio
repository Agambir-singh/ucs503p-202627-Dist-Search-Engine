<mxfile host="app.diagrams.net"><diagram id="d1" name="Activity Flow"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="ShardSeek · Distributed Search Engine" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="150" y="10" width="720" height="50" as="geometry"/></mxCell><mxCell id="c1" value="Search Activity Flow" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=20;spacingTop=8;fontSize=17;fontStyle=1;fillColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="25" y="100" width="975" height="1127" as="geometry"/></mxCell><mxCell id="c2" value="Document Ingestion Flow" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=20;spacingTop=8;fontSize=17;fontStyle=1;fillColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="25" y="1251" width="975" height="195" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="442" y="149" width="36" height="36" as="geometry"/></mxCell><mxCell id="t1" value="User submits a search" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="485" y="180" width="180" height="26" as="geometry"/></mxCell><mxCell id="ctrl" value="&lt;b style=&quot;font-size:14px&quot;&gt;Search Controller&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Receives GET /api/search?q=...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="330" y="233" width="286" height="77" as="geometry"/></mxCell><mxCell id="dec" value="Cached?" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=2;fontStyle=1;fontSize=14;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="405" y="343" width="134" height="100" as="geometry"/></mxCell><mxCell id="hit" value="&lt;b style=&quot;font-size:14px&quot;&gt;Cache hit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Return saved Top-K&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="47" y="351" width="204" height="84" as="geometry"/></mxCell><mxCell id="fan" value="&lt;b style=&quot;font-size:14px&quot;&gt;Coordinator fan-out&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Starts four workers in parallel&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="328" y="492" width="293" height="76" as="geometry"/></mxCell><mxCell id="fork" value="" style="rounded=0;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="293" y="603" width="372" height="6" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b style=&quot;font-size:14px&quot;&gt;Shard 0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;BM25 score&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="231" y="642" width="114" height="76" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Shard 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;BM25 score&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="356" y="642" width="114" height="76" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b style=&quot;font-size:14px&quot;&gt;Shard 2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;BM25 score&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="481" y="642" width="114" height="76" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b style=&quot;font-size:14px&quot;&gt;Shard 3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;BM25 score&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="608" y="642" width="114" height="76" as="geometry"/></mxCell><mxCell id="join" value="" style="rounded=0;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="293" y="757" width="372" height="6" as="geometry"/></mxCell><mxCell id="merge" value="&lt;b style=&quot;font-size:14px&quot;&gt;Merge and rank Top-K&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Sort candidate scores from every shard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="316" y="806" width="326" height="76" as="geometry"/></mxCell><mxCell id="save" value="&lt;b style=&quot;font-size:14px&quot;&gt;Save response to cache&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Next identical request is a cache hit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="316" y="924" width="328" height="78" as="geometry"/></mxCell><mxCell id="ret" value="&lt;b style=&quot;font-size:14px&quot;&gt;Return ranked results&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Title · snippet · score · shard · latency&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="316" y="1042" width="328" height="78" as="geometry"/></mxCell><mxCell id="end" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="460" y="1165" width="38" height="38" as="geometry"/></mxCell><mxCell id="panel" value="What each shard does" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=16;fontStyle=1;fillColor=#ffffff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="733" y="133" width="260" height="578" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b style=&quot;font-size:14px&quot;&gt;1. Tokenize document text&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;title + content&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="749" y="192" width="231" height="76" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b style=&quot;font-size:14px&quot;&gt;2. Calculate BM25&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;term frequency + relevance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="749" y="308" width="231" height="76" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b style=&quot;font-size:14px&quot;&gt;3. Return local matches&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;candidates for coordinator&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="749" y="424" width="231" height="76" as="geometry"/></mxCell><mxCell id="pn" value="Planned next" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="745" y="533" width="150" height="28" as="geometry"/></mxCell><mxCell id="pl1" value="Redis cache" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;strokeWidth=2;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="745" y="571" width="106" height="46" as="geometry"/></mxCell><mxCell id="pl2" value="Docker + etcd" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;strokeWidth=2;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="857" y="571" width="126" height="46" as="geometry"/></mxCell><mxCell id="pl3" value="Vector embeddings + hybrid ranking" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;strokeWidth=2;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="745" y="633" width="240" height="50" as="geometry"/></mxCell><mxCell id="istart" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="44" y="1345" width="38" height="38" as="geometry"/></mxCell><mxCell id="i1" value="&lt;b style=&quot;font-size:14px&quot;&gt;POST /documents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;validate request&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="270" y="1325" width="201" height="80" as="geometry"/></mxCell><mxCell id="i2" value="&lt;b style=&quot;font-size:14px&quot;&gt;Hash document ID&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;select a logical shard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="507" y="1325" width="203" height="80" as="geometry"/></mxCell><mxCell id="i3" value="&lt;b style=&quot;font-size:14px&quot;&gt;Index + clear cache&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;new content becomes searchable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="741" y="1325" width="246" height="80" as="geometry"/></mxCell><mxCell id="e1"