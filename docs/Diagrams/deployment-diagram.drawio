        <!-- Communication paths -->
        <mxCell id="e1" value="REST (search)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="coord">
