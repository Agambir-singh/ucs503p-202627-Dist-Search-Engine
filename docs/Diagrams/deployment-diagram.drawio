        <mxCell id="coord" value="&lt;&lt;container&gt;&gt;&lt;br&gt;&lt;b&gt;Search Coordinator&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=20;verticalAlign=top;align=center;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="host">
          <mxGeometry x="30" y="300" width="200" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="coordart" value="&lt;&lt;artifact&gt;&gt;&lt;br&gt;Search Coordinator&lt;br&gt;(Spring Boot)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="coord">
