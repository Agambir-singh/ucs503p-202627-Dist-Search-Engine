        <mxCell id="redisart" value="&lt;&lt;artifact&gt;&gt;&lt;br&gt;Redis" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="redis">
