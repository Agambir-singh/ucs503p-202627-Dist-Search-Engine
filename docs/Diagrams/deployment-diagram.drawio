        <mxCell id="s0a" value="&lt;&lt;artifact&gt;&gt;&lt;br&gt;Shard Service&lt;br&gt;(local index)" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="s0">
          <mxGeometry x="10" y="45" width="130" height="70" as="geometry"/>
