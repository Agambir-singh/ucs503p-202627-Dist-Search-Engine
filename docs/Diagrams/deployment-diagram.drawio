<mxfile host="app.diagrams.net">
  <diagram id="shardseek-deployment" name="ShardSeek Deployment Diagram">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;ShardSeek &#8211; Distributed Search Engine&lt;/b&gt;&lt;br&gt;Deployment Diagram" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- External devices -->
        <mxCell id="client" value="&lt;&lt;device&gt;&gt;&lt;br&gt;&lt;b&gt;User Device&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=20;verticalAlign=top;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="30" y="320" width="160" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="clientart" value="&lt;&lt;artifact&gt;&gt;&lt;br&gt;Browser /&lt;br&gt;REST client" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="client">
          <mxGeometry x="20" y="65" width="115" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="admin" value="&lt;&lt;device&gt;&gt;&lt;br&gt;&lt;b&gt;Admin / Content Source&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=20;verticalAlign=top;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="30" y="560" width="160" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="adminart" value="&lt;&lt;artifact&gt;&gt;&lt;br&gt;Admin tool /&lt;br&gt;document feeder" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="admin">
          <mxGeometry x="20" y="75" width="115" height="60" as="geometry"/>
        </mxCell>

        <!-- Docker host -->
        <mxCell id="host" value="&lt;&lt;execution environment&gt;&gt;&lt;br&gt;&lt;b&gt;Docker Host&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.03;darkOpacity2=0.05;size=25;verticalAlign=top;align=center;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="20" width="1120" height="740" as="geometry"/>
