        <mxCell id="e6" value="register" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5676;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="cluster" target="etcd">
          <mxGeometry relative="1" as="geometry"/>
