        <mxCell id="s3" value="&lt;&lt;container&gt;&gt;&lt;br&gt;&lt;b&gt;Shard 3&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=15;verticalAlign=top;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="cluster">
