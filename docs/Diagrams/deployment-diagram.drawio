        <mxCell id="e7" value="gRPC (indexing)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.267;entryX=0.081;entryY=1;" edge="1" parent="1" source="indexer" target="cluster">
