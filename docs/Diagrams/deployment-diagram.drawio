        <mxCell id="s1" value="&lt;&lt;container&gt;&gt;&lt;br&gt;&lt;b&gt;Shard 1&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=15;verticalAlign=top;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="cluster">
          <mxGeometry x="200" y="60" width="165" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="s1a" value="&lt;&lt;artifact&gt;&gt;&lt;br&gt;Shard Service&lt;br&gt;(local index)" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="s1">
          <mxGeometry x="10" y="45" width="130" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;&lt;container&gt;&gt;&lt;br&gt;&lt;b&gt;Shard 2&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=15;verticalAlign=top;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="cluster">
          <mxGeometry x="380" y="60" width="165" height="125" as="geometry"/>
