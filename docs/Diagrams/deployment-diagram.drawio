        <mxCell id="redis" value="&lt;&lt;container&gt;&gt;&lt;br&gt;&lt;b&gt;Cache&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=20;verticalAlign=top;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="host">
          <mxGeometry x="360" y="30" width="200" height="110" as="geometry"/>
